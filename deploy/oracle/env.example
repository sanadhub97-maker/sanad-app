TRUSTED_ORIGINS=https://sept.cloud,https://sanad-hr.sept.cloud

DATABASE_URL=
DIRECT_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SETTINGS_ENCRYPTION_KEY=

STORAGE_DRIVER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
