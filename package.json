{
  "name": "sanad-documents-licenses-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build:server": "npm run build --workspace server",
    "build:client": "npm run build --workspace client",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:migrate": "npm run prisma:migrate --workspace server",
    "prisma:seed": "npm run prisma:seed --workspace server",
    "test:server": "npm test --workspace server",
    "test:build-security": "node --test scripts/build-dependency-security.test.cjs"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "puppeteer@25.12.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5",
    "uuid": "11.1.1",
    "braces": "$braces",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.6"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5",
    "uuid": "11.1.1",
    "@prisma/client": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "braces": "file:vendor/braces-3.0.4.tgz"
  }
}
