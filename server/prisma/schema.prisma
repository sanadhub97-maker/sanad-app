// SanaD Documents & Licenses Management System — Database Schema
// See README.md for the schema-consolidation note on CompanyDocument vs. "Licenses".

generator client {
  provider = "prisma-client-js"
}

// Connection URLs live in prisma.config.ts (migrations) and src/lib/prisma.ts
// (the app, through the pg driver adapter).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum DocumentStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
}

enum EmployeeDocumentType {
  IQAMA
  PASSPORT
  HEALTH_CERTIFICATE
  MEDICAL_INSURANCE
  EMPLOYMENT_CONTRACT
  VISA
  EXIT_REENTRY_VISA
  FINAL_EXIT_VISA
  FLIGHT_TICKET
  DRIVING_LICENSE
  OTHER
}

// Covers both the "Company Documents" (§15) and "Licenses" (§17) modules —
// the frontend renders /company-documents and /licenses as two filtered
// views over this same table (see README "Architecture Decisions").
enum CompanyDocumentCategory {
  COMMERCIAL_REGISTRATION
  MUNICIPAL_LICENSE
  CIVIL_DEFENSE_LICENSE
  CIVIL_DEFENSE_REPORT
  CLEANING_CONTRACT
  LEASE_CONTRACT
  TWENTY_FOUR_HOUR_PERMIT
  ENTERTAINMENT_AUTHORITY_PERMIT
  TOBACCO_LICENSE
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  OTHER
}

enum PaymentCategory {
  RENT_PAYMENT
  INTERNET
  ELECTRICITY
  WATER
  MAINTENANCE
  PURCHASES
  COMMERCIAL_REGISTRATION
  MUNICIPAL_LICENSE
  TOBACCO_LICENSE
  PERMIT_24H
  COMMERCIAL_REGISTRATION_ISSUE
  COMMERCIAL_REGISTRATION_RENEWAL
  COMMERCIAL_REGISTRATION_AMENDMENT
  COMMERCIAL_REGISTRATION_CANCELLATION
  MUNICIPAL_LICENSE_ISSUE
  MUNICIPAL_LICENSE_RENEWAL
  MUNICIPAL_LICENSE_AMENDMENT
  MUNICIPAL_LICENSE_CANCELLATION
  CHAMBER_OF_COMMERCE
  IQAMA_ISSUE
  IQAMA_RENEWAL
  WORK_PERMIT
  EXPAT_LEVY
  DEPENDENTS_FEE
  PROFESSION_CHANGE
  SPONSORSHIP_TRANSFER
  WORK_VISA
  EXIT_REENTRY_VISA
  FINAL_EXIT_VISA
  GOSI
  MEDICAL_INSURANCE
  ZAKAT_TAX
  GOVERNMENT_FINES
  GOVERNMENT_FEES
  EMPLOYEE_DOCUMENTS
  LICENSES
  INSURANCE
  RENT
  CLEANING
  CIVIL_DEFENSE
  MUNICIPALITY
  VISA
  IQAMA
  PASSPORT
  MEDICAL
  OTHER
}

enum NotificationSeverity {
  CRITICAL
  WARNING
  INFO
}

enum NotificationChannel {
  SYSTEM
  EMAIL
  WHATSAPP
}

enum NotificationLogStatus {
  SENT
  FAILED
  SKIPPED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
  EXPORT
  DOWNLOAD
  LOGIN
  LOGOUT
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Identity, RBAC, sessions
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  fullName         String
  email            String    @unique
  phone            String?
  passwordHash     String
  isActive         Boolean   @default(true)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  avatarFileId     String?
  /** A ready-made illustrated avatar (see client saudi-avatars-data), used when no photo is uploaded. */
  avatarKey        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  userRoles              UserRole[]
  sessions                Session[]
  passkeys                Passkey[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  auditLogs                AuditLog[]
  uploadedFiles            File[]
  createdPayments          Payment[]        @relation("PaymentCreatedBy")
  managedBranches          Branch[]         @relation("BranchManager")
  importJobs               ImportJob[]
  assignedTasks            DailyTask[]      @relation("TaskAssignee")
  createdTasks             DailyTask[]      @relation("TaskCreator")
  reportSchedules         ReportSchedule[]
  alertAcknowledgements   AlertAcknowledgement[]
  recordedHandovers       AssetHandover[]
  assignedRenewals        RenewalCase[]
  assignedViolations      Violation[]      @relation("ViolationAssignee")
  createdViolations       Violation[]      @relation("ViolationCreator")
  violationEvents         ViolationEvent[]
  createdTaxReturns       TaxReturn[]      @relation("TaxReturnCreator")

  @@index([isActive])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "employees.view"
  description String?
  module      String

  rolePermissions RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id         String    @id @default(cuid())
  familyId   String    @default(uuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  passkeyId  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  passkey Passkey? @relation(fields: [passkeyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
}

model DocumentRevision {
  id String @id @default(cuid())
  subjectType String
  subjectId String
  subjectName String
  documentKind String
  actorId String?
  actorName String
  before Json
  after Json
  createdAt DateTime @default(now())
  @@index([subjectType, subjectId, createdAt])
}

model BackupSnapshot {
  id String @id @default(cuid())
  status String
  storedName String?
  checksum String?
  recordCount Int @default(0)
  fileCount Int @default(0)
  totalBytes BigInt @default(0)
  error String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([createdAt])
}

model MaintenanceLease {
  id String @id
  token String
  expiresAt DateTime
}

model Passkey {
  id           String @id
  userId       String
  rpId         String
  publicKey    Bytes
  counter      BigInt @default(0)
  transports   String[]
  name         String
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     Session[]
  @@index([userId, rpId])
}

// Short-lived, single-use ceremonies; no biometric information is stored.
model PasskeyChallenge {
  id           String @id
  challenge    String
  purpose      String
  userId       String?
  passwordProof String?
  origin       String
  rpId         String
  rememberMe   Boolean @default(false)
  expiresAt    DateTime
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Branches
// ---------------------------------------------------------------------------

model Branch {
  ownerName String?
  vatRegistrationNumber String?
  selectedTaxReturns TaxReturnBranch[]
  id        String       @id @default(cuid())
  name      String
  nameEn    String?
  code      String       @unique
  city      String?
  cityEn    String?
  address   String?
  phone     String?
  email     String?
  managerId String?
  status    BranchStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  manager          User?             @relation("BranchManager", fields: [managerId], references: [id])
  employees        Employee[]
  companyDocuments CompanyDocument[]
  payments         Payment[]
  assets           ManagedAsset[]
  violations       Violation[]
  taxReturns       TaxReturn[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Employees
// ---------------------------------------------------------------------------

model Employee {
  id               String           @id @default(cuid())
  employeeNumber   String           @unique
  fullNameAr       String
  fullNameEn       String?
  nationality      String?
  nationalityEn    String?
  gender           Gender?
  dateOfBirth      DateTime?
  mobile           String?
  email            String?
  address          String?
  city             String?
  cityEn           String?
  jobTitle         String?
  jobTitleEn       String?
  department       String?
  departmentEn     String?
  branchId         String?
  joiningDate      DateTime?
  employmentStatus EmploymentStatus @default(ACTIVE)
  notes            String?
  sponsorName      String?
  /// On the company sponsorship (kafala); null when not recorded.
  onSponsorship    Boolean?

  iqamaNumber      String?
  iqamaIssueDate   DateTime?
  iqamaExpiryDate  DateTime?
  iqamaFileId      String?

  passportNumber       String?
  passportCountry      String?
  passportIssueDate    DateTime?
  passportExpiryDate   DateTime?
  passportFileId       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branch    Branch?            @relation(fields: [branchId], references: [id])
  documents EmployeeDocument[]
  payments  Payment[]
  violations Violation[]
  onboarding EmployeeOnboarding?
  assetHandovers AssetHandover[]
  offboarding EmployeeOffboarding?

  @@index([branchId])
  @@index([employmentStatus])
  @@index([iqamaExpiryDate])
  @@index([passportExpiryDate])
}

model EmployeeDocument {
  id              String               @id @default(cuid())
  employeeId      String
  type            EmployeeDocumentType
  name            String?
  documentNumber  String?
  issuingAuthority String?
  issueDate       DateTime?
  startDate       DateTime?
  expiryDate      DateTime?
  cachedStatus    DocumentStatus?
  fileId          String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([expiryDate])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Company Documents (also serves the "Licenses" views — see enum comment)
// ---------------------------------------------------------------------------

model CompanyDocument {
  id               String                   @id @default(cuid())
  category         CompanyDocumentCategory
  name             String
  documentNumber   String?
  licenseNumber    String?
  issuingAuthority String?
  branchId         String?
  city             String?
  issueDate        DateTime?
  startDate        DateTime?
  expiryDate       DateTime?
  cachedStatus     DocumentStatus?
  fileId           String?
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([category])
  @@index([expiryDate])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id              String           @id @default(cuid())
  paymentNumber   String           @unique
  paymentDate     DateTime
  type            String?
  category        PaymentCategory
  description     String?
  amount          Decimal          @db.Decimal(12, 2)
  vat             Decimal          @default(0) @db.Decimal(12, 2)
  total           Decimal          @db.Decimal(12, 2)
  method          PaymentMethod
  paidBy          String?
  branchId        String?
  employeeId      String?
  supplierName    String?
  referenceNumber String?
  fileId          String?
  notes           String?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  branch    Branch?  @relation(fields: [branchId], references: [id])
  employee  Employee? @relation(fields: [employeeId], references: [id])
  createdBy User      @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  violation Violation?
  taxReturn TaxReturn?

  @@index([branchId])
  @@index([employeeId])
  @@index([category])
  @@index([paymentDate])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id          String               @id @default(cuid())
  userId      String?
  severity    NotificationSeverity
  title       String
  message     String
  /** Arabic title and message; title/message hold the English text. */
  titleAr     String?
  messageAr   String?
  relatedType String?
  relatedId   String?
  isRead      Boolean              @default(false)
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// One row per (document, threshold, channel) send — the unique dedupeKey is
// what makes the daily expiration scan idempotent (§21/§41).
model NotificationLog {
  id           String                 @id @default(cuid())
  dedupeKey    String                 @unique
  channel      NotificationChannel
  templateCode String?
  recipient    String?
  relatedType  String?
  relatedId    String?
  /// The text sent (WhatsApp/email), shown in the live feed in Settings.
  message      String?
  status       NotificationLogStatus
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime               @default(now())

  @@index([channel, createdAt])
}

// ---------------------------------------------------------------------------
// Settings (singletons use fixed id = 1)
// ---------------------------------------------------------------------------

model EmailSettings {
  id                Int      @id @default(1)
  enabled           Boolean  @default(false)
  host              String?
  port              Int?
  secure            Boolean  @default(true)
  username          String?
  passwordEncrypted String?
  fromName          String?
  fromEmail         String?
  updatedAt         DateTime @updatedAt
}

model WhatsappSettings {
  id                 Int      @id @default(1)
  enabled            Boolean  @default(false)
  provider           String?
  apiUrl             String?
  apiKeyEncrypted    String?
  phoneNumberId      String?
  businessAccountId  String?
  updatedAt          DateTime @updatedAt
}

model CompanySettings {
  id             Int      @id @default(1)
  nameAr         String?
  nameEn         String?
  logoFileId     String?
  logoDarkFileId String?
  printLogoFileId String?
  faviconFileId  String?
  stampFileId    String?
  signatureFileId String?
  crNumber       String?
  vatNumber      String?
  phone          String?
  email          String?
  website        String?
  address        String?
  city           String?
  country        String?
  updatedAt      DateTime @updatedAt
}

// Generic key-value store for expiration thresholds, appearance, animation
// toggle, etc. — see README for the documented keys.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

model File {
  id           String   @id @default(cuid())
  originalName String
  storedName   String   @unique
  mimeType     String
  size         Int
  module       String?
  relatedId    String?
  uploadedById String
  version      Int      @default(1)
  createdAt    DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])
  violations Violation[]
  taxReturns TaxReturn[]

  @@index([module, relatedId])
}

// ---------------------------------------------------------------------------
// Audit logs
// ---------------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  module      String
  recordId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([module, recordId])
  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Excel import
// ---------------------------------------------------------------------------

model ImportJob {
  id            String          @id @default(cuid())
  module        String
  fileName      String
  status        ImportJobStatus @default(PENDING)
  totalRows     Int             @default(0)
  importedCount Int             @default(0)
  updatedCount  Int             @default(0)
  skippedCount  Int             @default(0)
  failedCount   Int             @default(0)
  createdById   String
  createdAt     DateTime        @default(now())
  completedAt   DateTime?

  createdBy User          @relation(fields: [createdById], references: [id])
  errors    ImportError[]
}

model ImportError {
  id          String   @id @default(cuid())
  importJobId String
  rowNumber   Int
  field       String?
  message     String
  rawData     Json?
  createdAt   DateTime @default(now())

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
}

// ---------------------------------------------------------------------------
// Daily tasks: a to-do list kept per calendar day, printable and exportable.
// ---------------------------------------------------------------------------

enum TaskPriority {
  URGENT
  HIGH
  NORMAL
}

model DailyTask {
  id          String       @id @default(cuid())
  date        DateTime     @db.Date
  title       String
  category    String       @default("general") // employees | documents | branches | payments | general
  priority    TaskPriority @default(NORMAL)
  assigneeId  String?
  time        String? // "HH:mm"
  notes       String?
  done        Boolean      @default(false)
  doneAt      DateTime?
  carriedFrom DateTime?    @db.Date // set when moved over from an earlier day
  sourceKey   String? // the system suggestion it was created from (e.g. an expired iqama)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  assignee  User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([sourceKey])
}

// A device that receives SanaD alerts as push notifications, even with the
// site closed. `via` is the page that holds the subscription: the app itself
// ("app") or the sanad-hr.sept.cloud page that shows it in a frame ("sept").
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  via        String    @default("app")
  device     String    @default("desktop") // "desktop" (computers) or "mobile" (phones, tablets, iPads)
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmployeeOnboarding {
  employeeId String @id
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  steps Json
  updatedAt DateTime @updatedAt
}

model AlertAcknowledgement {
  userId String
  key String
  acknowledgedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, key])
}

model ReportSchedule {
  id String @id @default(cuid())
  userId String
  name String
  kind String
  frequency String
  time String
  weekday Int @default(0)
  monthday Int @default(1)
  language String @default("ar")
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs GeneratedReport[]
  @@index([enabled])
}

model GeneratedReport {
  id String @id @default(cuid())
  scheduleId String
  slot String
  status String
  fileId String?
  error String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  schedule ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  @@unique([scheduleId, slot])
}

enum AssetState {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

model ManagedAsset {
  id String @id @default(cuid())
  code String @unique
  name String
  category String
  serialNumber String?
  branchId String?
  purchaseValue Decimal @default(0) @db.Decimal(12, 2)
  state AssetState @default(AVAILABLE)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  branch Branch? @relation(fields: [branchId], references: [id])
  handovers AssetHandover[]
  @@index([branchId, state])
}

model AssetHandover {
  id String @id @default(cuid())
  assetId String
  employeeId String
  recordedById String
  issuedAt DateTime @default(now())
  returnedAt DateTime?
  issuedCondition String
  returnedCondition String?
  notes String?
  asset ManagedAsset @relation(fields: [assetId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  recordedBy User @relation(fields: [recordedById], references: [id])
  @@index([employeeId, returnedAt])
  @@index([assetId, returnedAt])
}

model EmployeeOffboarding {
  id String @id @default(cuid())
  employeeId String @unique
  plannedDate DateTime @db.Date
  reason String
  steps Json
  status String @default("OPEN")
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee Employee @relation(fields: [employeeId], references: [id])
}

model RenewalCase {
  id String @id @default(cuid())
  sourceType String
  sourceId String
  title String
  ownerId String
  dueDate DateTime @db.Date
  status String @default("OPEN")
  estimatedCost Decimal @default(0) @db.Decimal(12, 2)
  notes String?
  paymentId String?
  taskId String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id])
  @@index([sourceType, sourceId, status])
  @@index([ownerId, dueDate])
}

// Violations: fines from government authorities on an establishment
// (AUTHORITY: the Labour office, Jawazat, the municipality, Civil Defence…)
// and internal penalties on an employee (STAFF). An authority violation is
// paid through a payment voucher (paymentId); objection dates and payment
// deadlines drive reminders. Statuses: NEW → OBJECTION → ACCEPTED/REJECTED,
// PAID for authority ones; OPEN → APPLIED for staff penalties.
enum ViolationKind {
  AUTHORITY
  STAFF
}

enum ViolationStatus {
  NEW
  OBJECTION
  ACCEPTED
  REJECTED
  PAID
  OPEN
  APPLIED
}

model Violation {
  id                String          @id @default(cuid())
  kind              ViolationKind
  authority         String? // a key from constants/violations ("labor", "jawazat"…) or "other"
  authorityName     String? // the authority's name when it is "other"
  number            String?
  date              DateTime        @db.Date
  branchId          String?
  employeeId        String?
  reason            String
  penalty           String? // staff penalties: warning, deduction…
  amount            Decimal         @default(0) @db.Decimal(12, 2)
  payDeadline       DateTime?       @db.Date
  objectionDeadline DateTime?       @db.Date
  status            ViolationStatus
  paymentId         String?         @unique
  relatedType       String? // the document that caused it (a TrackableItem source type)
  relatedId         String?
  relatedLabel      String?
  fileId            String?
  assigneeId        String?
  notes             String?
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  branch    Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee  Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  payment   Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  file      File?            @relation(fields: [fileId], references: [id], onDelete: SetNull)
  assignee  User?            @relation("ViolationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("ViolationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  events    ViolationEvent[]

  @@index([kind, status])
  @@index([branchId])
  @@index([employeeId])
  @@index([payDeadline])
}

// What happened to a violation, in order: recorded, objected, the objection's
// result, paid, applied, edited.
model ViolationEvent {
  id          String    @id @default(cuid())
  violationId String
  type        String // created | objection | accepted | rejected | paid | applied | edited
  date        DateTime  @db.Date
  note        String?
  userId      String?
  createdAt   DateTime  @default(now())

  violation Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([violationId])
}

// ---------------------------------------------------------------------------
// Tax returns: the quarterly VAT return and the yearly zakat return filed with
// ZATCA, with the amounts entered on them. The periods themselves are worked
// out from the "tax.config" setting (who files, since when), so a period with
// no row yet still shows, and is reminded of, as "not filed".
// ---------------------------------------------------------------------------

enum TaxReturnKind {
  VAT
  ZAKAT
}

enum TaxReturnStatus {
  DRAFT
  FILED
  PAID
}

model TaxReturn {
  selectedBranches TaxReturnBranch[]
  id                String          @id @default(cuid())
  kind              TaxReturnKind
  /// The establishment filing it; null = the company as one taxpayer.
  branchId          String?
  year              Int
  /// 1–4 for VAT; null for zakat.
  quarter           Int?
  dueDate           DateTime        @db.Date
  status            TaxReturnStatus @default(DRAFT)
  // VAT return boxes (amounts before tax)
  salesStandard     Decimal         @default(0) @db.Decimal(14, 2)
  salesZero         Decimal         @default(0) @db.Decimal(14, 2)
  salesExports      Decimal         @default(0) @db.Decimal(14, 2)
  salesExempt       Decimal         @default(0) @db.Decimal(14, 2)
  purchasesStandard Decimal         @default(0) @db.Decimal(14, 2)
  purchasesImports  Decimal         @default(0) @db.Decimal(14, 2)
  purchasesZero     Decimal         @default(0) @db.Decimal(14, 2)
  purchasesExempt   Decimal         @default(0) @db.Decimal(14, 2)
  outputVat         Decimal         @default(0) @db.Decimal(14, 2)
  inputVat          Decimal         @default(0) @db.Decimal(14, 2)
  corrections       Decimal         @default(0) @db.Decimal(14, 2)
  // Zakat
  zakatBase         Decimal?        @db.Decimal(16, 2)
  /// What is owed for the period: the net VAT, or the zakat.
  amount            Decimal         @default(0) @db.Decimal(14, 2)
  /// A late-payment fine paid with it, if any.
  penalty           Decimal         @default(0) @db.Decimal(14, 2)
  filedDate         DateTime?       @db.Date
  reference         String?
  ownerName         String?
  sadadNumber       String?
  paymentId         String?         @unique
  fileId            String?
  notes             String?
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  file      File?    @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("TaxReturnCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([kind, year, quarter])
  @@index([branchId])
  @@index([dueDate])
}

model TaxReturnBranch {
  taxReturnId String
  branchId String
  nameSnapshot String
  taxReturn TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  @@id([taxReturnId, branchId])
  @@index([branchId])
}
