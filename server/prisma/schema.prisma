// SanaD Documents & Licenses Management System — Database Schema
// See README.md for the schema-consolidation note on CompanyDocument vs. "Licenses".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum DocumentStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
}

enum EmployeeDocumentType {
  IQAMA
  PASSPORT
  HEALTH_CERTIFICATE
  MEDICAL_INSURANCE
  EMPLOYMENT_CONTRACT
  VISA
  EXIT_REENTRY_VISA
  FINAL_EXIT_VISA
  FLIGHT_TICKET
  DRIVING_LICENSE
  OTHER
}

// Covers both the "Company Documents" (§15) and "Licenses" (§17) modules —
// the frontend renders /company-documents and /licenses as two filtered
// views over this same table (see README "Architecture Decisions").
enum CompanyDocumentCategory {
  COMMERCIAL_REGISTRATION
  MUNICIPAL_LICENSE
  CIVIL_DEFENSE_LICENSE
  CIVIL_DEFENSE_REPORT
  CLEANING_CONTRACT
  LEASE_CONTRACT
  TWENTY_FOUR_HOUR_PERMIT
  ENTERTAINMENT_AUTHORITY_PERMIT
  TOBACCO_LICENSE
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  OTHER
}

enum PaymentCategory {
  COMMERCIAL_REGISTRATION
  MUNICIPAL_LICENSE
  TOBACCO_LICENSE
  PERMIT_24H
  COMMERCIAL_REGISTRATION_ISSUE
  COMMERCIAL_REGISTRATION_RENEWAL
  COMMERCIAL_REGISTRATION_AMENDMENT
  COMMERCIAL_REGISTRATION_CANCELLATION
  MUNICIPAL_LICENSE_ISSUE
  MUNICIPAL_LICENSE_RENEWAL
  MUNICIPAL_LICENSE_AMENDMENT
  MUNICIPAL_LICENSE_CANCELLATION
  CHAMBER_OF_COMMERCE
  IQAMA_ISSUE
  IQAMA_RENEWAL
  WORK_PERMIT
  EXPAT_LEVY
  DEPENDENTS_FEE
  PROFESSION_CHANGE
  SPONSORSHIP_TRANSFER
  WORK_VISA
  EXIT_REENTRY_VISA
  FINAL_EXIT_VISA
  GOSI
  MEDICAL_INSURANCE
  ZAKAT_TAX
  GOVERNMENT_FINES
  GOVERNMENT_FEES
  EMPLOYEE_DOCUMENTS
  LICENSES
  INSURANCE
  RENT
  CLEANING
  CIVIL_DEFENSE
  MUNICIPALITY
  VISA
  IQAMA
  PASSPORT
  MEDICAL
  OTHER
}

enum NotificationSeverity {
  CRITICAL
  WARNING
  INFO
}

enum NotificationChannel {
  SYSTEM
  EMAIL
  WHATSAPP
}

enum NotificationLogStatus {
  SENT
  FAILED
  SKIPPED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
  EXPORT
  DOWNLOAD
  LOGIN
  LOGOUT
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Identity, RBAC, sessions
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  fullName         String
  email            String    @unique
  phone            String?
  passwordHash     String
  isActive         Boolean   @default(true)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  avatarFileId     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  userRoles              UserRole[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  notifications           Notification[]
  auditLogs                AuditLog[]
  uploadedFiles            File[]
  createdPayments          Payment[]        @relation("PaymentCreatedBy")
  managedBranches          Branch[]         @relation("BranchManager")
  importJobs               ImportJob[]

  @@index([isActive])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "employees.view"
  description String?
  module      String

  rolePermissions RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Branches
// ---------------------------------------------------------------------------

model Branch {
  id        String       @id @default(cuid())
  name      String
  nameEn    String?
  code      String       @unique
  city      String?
  cityEn    String?
  address   String?
  phone     String?
  email     String?
  managerId String?
  status    BranchStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  manager          User?             @relation("BranchManager", fields: [managerId], references: [id])
  employees        Employee[]
  companyDocuments CompanyDocument[]
  payments         Payment[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Employees
// ---------------------------------------------------------------------------

model Employee {
  id               String           @id @default(cuid())
  employeeNumber   String           @unique
  fullNameAr       String
  fullNameEn       String?
  nationality      String?
  nationalityEn    String?
  gender           Gender?
  dateOfBirth      DateTime?
  mobile           String?
  email            String?
  address          String?
  city             String?
  cityEn           String?
  jobTitle         String?
  jobTitleEn       String?
  department       String?
  departmentEn     String?
  branchId         String?
  joiningDate      DateTime?
  employmentStatus EmploymentStatus @default(ACTIVE)
  notes            String?

  iqamaNumber      String?
  iqamaIssueDate   DateTime?
  iqamaExpiryDate  DateTime?
  iqamaFileId      String?

  passportNumber       String?
  passportCountry      String?
  passportIssueDate    DateTime?
  passportExpiryDate   DateTime?
  passportFileId       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branch    Branch?            @relation(fields: [branchId], references: [id])
  documents EmployeeDocument[]
  payments  Payment[]

  @@index([branchId])
  @@index([employmentStatus])
  @@index([iqamaExpiryDate])
  @@index([passportExpiryDate])
}

model EmployeeDocument {
  id              String               @id @default(cuid())
  employeeId      String
  type            EmployeeDocumentType
  name            String?
  documentNumber  String?
  issuingAuthority String?
  issueDate       DateTime?
  startDate       DateTime?
  expiryDate      DateTime?
  cachedStatus    DocumentStatus?
  fileId          String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([expiryDate])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Company Documents (also serves the "Licenses" views — see enum comment)
// ---------------------------------------------------------------------------

model CompanyDocument {
  id               String                   @id @default(cuid())
  category         CompanyDocumentCategory
  name             String
  documentNumber   String?
  licenseNumber    String?
  issuingAuthority String?
  branchId         String?
  city             String?
  issueDate        DateTime?
  startDate        DateTime?
  expiryDate       DateTime?
  cachedStatus     DocumentStatus?
  fileId           String?
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([category])
  @@index([expiryDate])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id              String           @id @default(cuid())
  paymentNumber   String           @unique
  paymentDate     DateTime
  type            String?
  category        PaymentCategory
  description     String?
  amount          Decimal          @db.Decimal(12, 2)
  vat             Decimal          @default(0) @db.Decimal(12, 2)
  total           Decimal          @db.Decimal(12, 2)
  method          PaymentMethod
  paidBy          String?
  branchId        String?
  employeeId      String?
  supplierName    String?
  referenceNumber String?
  fileId          String?
  notes           String?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  branch    Branch?  @relation(fields: [branchId], references: [id])
  employee  Employee? @relation(fields: [employeeId], references: [id])
  createdBy User      @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([branchId])
  @@index([employeeId])
  @@index([category])
  @@index([paymentDate])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id          String               @id @default(cuid())
  userId      String?
  severity    NotificationSeverity
  title       String
  message     String
  relatedType String?
  relatedId   String?
  isRead      Boolean              @default(false)
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// One row per (document, threshold, channel) send — the unique dedupeKey is
// what makes the daily expiration scan idempotent (§21/§41).
model NotificationLog {
  id           String                 @id @default(cuid())
  dedupeKey    String                 @unique
  channel      NotificationChannel
  templateCode String?
  recipient    String?
  relatedType  String?
  relatedId    String?
  status       NotificationLogStatus
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime               @default(now())
}

// ---------------------------------------------------------------------------
// Settings (singletons use fixed id = 1)
// ---------------------------------------------------------------------------

model EmailSettings {
  id                Int      @id @default(1)
  enabled           Boolean  @default(false)
  host              String?
  port              Int?
  secure            Boolean  @default(true)
  username          String?
  passwordEncrypted String?
  fromName          String?
  fromEmail         String?
  updatedAt         DateTime @updatedAt
}

model WhatsappSettings {
  id                 Int      @id @default(1)
  enabled            Boolean  @default(false)
  provider           String?
  apiUrl             String?
  apiKeyEncrypted    String?
  phoneNumberId      String?
  businessAccountId  String?
  updatedAt          DateTime @updatedAt
}

model CompanySettings {
  id             Int      @id @default(1)
  nameAr         String?
  nameEn         String?
  logoFileId     String?
  logoDarkFileId String?
  printLogoFileId String?
  faviconFileId  String?
  stampFileId    String?
  signatureFileId String?
  crNumber       String?
  vatNumber      String?
  phone          String?
  email          String?
  website        String?
  address        String?
  city           String?
  country        String?
  updatedAt      DateTime @updatedAt
}

// Generic key-value store for expiration thresholds, appearance, animation
// toggle, etc. — see README for the documented keys.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

model File {
  id           String   @id @default(cuid())
  originalName String
  storedName   String   @unique
  mimeType     String
  size         Int
  module       String?
  relatedId    String?
  uploadedById String
  version      Int      @default(1)
  createdAt    DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([module, relatedId])
}

// ---------------------------------------------------------------------------
// Audit logs
// ---------------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  module      String
  recordId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([module, recordId])
  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Excel import
// ---------------------------------------------------------------------------

model ImportJob {
  id            String          @id @default(cuid())
  module        String
  fileName      String
  status        ImportJobStatus @default(PENDING)
  totalRows     Int             @default(0)
  importedCount Int             @default(0)
  updatedCount  Int             @default(0)
  skippedCount  Int             @default(0)
  failedCount   Int             @default(0)
  createdById   String
  createdAt     DateTime        @default(now())
  completedAt   DateTime?

  createdBy User          @relation(fields: [createdById], references: [id])
  errors    ImportError[]
}

model ImportError {
  id          String   @id @default(cuid())
  importJobId String
  rowNumber   Int
  field       String?
  message     String
  rawData     Json?
  createdAt   DateTime @default(now())

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
}
