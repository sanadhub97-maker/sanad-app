# ---------------------------------------------------------------------------
# Database (Neon Postgres — see README "Database Setup (Neon)")
# DATABASE_URL: the pooled connection string (has "-pooler" in the host) —
# used by the app at runtime.
# DIRECT_URL: the same project's direct (non-pooled) connection string —
# required by Prisma Migrate, since DDL + advisory locks don't work through
# PgBouncer. Derive it by removing "-pooler" from the host.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-example-12345-pooler.eu-central-1.aws.neon.tech/sanad?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example-12345.eu-central-1.aws.neon.tech/sanad?sslmode=require"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
# Symmetric key (32 bytes, base64) used to encrypt secrets-at-rest (SMTP/WhatsApp
# API keys) stored in the database. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY="change-me-32-byte-base64-key"

# ---------------------------------------------------------------------------
# Initial Super Admin (used only by the seed script, first run)
# ---------------------------------------------------------------------------
SEED_SUPERADMIN_NAME="Super Admin"
SEED_SUPERADMIN_EMAIL="admin@example.com"
SEED_SUPERADMIN_PASSWORD="ChangeMe123!"

# ---------------------------------------------------------------------------
# File storage (local disk by default; set STORAGE_DRIVER=s3 to use an
# S3-compatible backend such as Neon Object Storage)
# ---------------------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15
STORAGE_DRIVER="local"
# STORAGE_DRIVER="s3"
# STORAGE_ENDPOINT="https://<branch-id>.s3.<region>.aws.neon.tech" # from Neon Object Storage
# STORAGE_REGION="us-east-2" # match your Neon project's region
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""

# ---------------------------------------------------------------------------
# Email (SMTP) — leave EMAIL_ENABLED=false until configured; Settings UI can
# also toggle/override these at runtime.
# ---------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM_NAME="SanaD Documents & Licenses"
EMAIL_FROM_ADDRESS=""

# ---------------------------------------------------------------------------
# WhatsApp Business API — leave WHATSAPP_ENABLED=false until configured.
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
EXPIRATION_SCAN_CRON="0 6 * * *"
